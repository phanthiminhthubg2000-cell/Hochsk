": "第46-50题：选词填空。", "ref": {"kind": "words", "items": [{"k": "A", "hz": "重"}, {"k": "B", "hz": "首先"}, {"k": "C", "hz": "观众"}, {"k": "D", "hz": "坚持"}, {"k": "E", "hz": "擦"}, {"k": "F", "hz": "地点"}]}, "unique": true, "qs": [{"n": 46, "t": "m", "a": "E", "pre": "爷爷，为什么橡皮能", "post": "掉铅笔写的字？"}, {"n": 47, "t": "m", "a": "C", "pre": "这部电影非常感人，很多", "post": "都被感动得哭了。"}, {"n": 48, "t": "m", "a": "B", "pre": "不管别人怎么说，", "post": "你要对自己有信心才行。"}, {"n": 49, "t": "m", "a": "F", "pre": "这次聚会的", "post": "是小李选的，时间也是他定的。"}, {"n": 50, "t": "m", "a": "A", "pre": "谢谢，不用了，这个行李箱一点儿都不", "post": "，里面都是衣服。"}], "ex": "她每天都（<b class='exa'>D</b>）走路上下班，所以身体一直很不错。", "exUsed": "D"}, {"sec": "R", "part": 1, "label": "51-55", "head": "第51-55题：选词填空。", "ref": {"kind": "words", "items": [{"k": "A", "hz": "难受"}, {"k": "B", "hz": "郊区"}, {"k": "C", "hz": "温度"}, {"k": "D", "hz": "流行"}, {"k": "E", "hz": "香"}, {"k": "F", "hz": "恐怕"}]}, "unique": true, "qs": [{"n": 51, "t": "m", "a": "F", "pre": "A：家里的果汁够吗？要不要再买几瓶？<br>B：要是明天来的人多，", "post": "会不够，再买两瓶吧。"}, {"n": 52, "t": "m", "a": "B", "pre": "A：听说公司明年要搬到", "post": "，到时候我又得重新租房子了。<br>B：这个消息准确吗？我怎么不知道？"}, {"n": 53, "t": "m", "a": "A", "pre": "A：你稍微开慢点儿，我有点儿", "post": "。<br>B：你怎么了？实在不行，我们在路边停下来休息会儿。"}, {"n": 54, "t": "m", "a": "E", "pre": "A：面条儿做好了，快来吃吧。<br>B：真", "post": "啊，我最喜欢吃你做的西红柿鸡蛋面了。"}, {"n": 55, "t": "m", "a": "D", "pre": "A：姐，你觉得这条蓝色的裙子怎么样？<br>B：挺好的，今年", "post": "蓝色，而且夏天穿这样的裙子也凉快。"}], "ex": "A：今天真冷啊，好像白天最高（<b class='exa'>C</b>）才2℃。<br>B：刚才电视里说明天更冷。", "exUsed": "C"}, {"sec": "R", "part": 2, "label": "56-60", "head": "第56-65题：排列顺序。", "ex": "A 可是今天起晚了　B 平时我骑自行车上下班　C 所以就打车来公司 → B A C", "qs": [{"n": 56, "t": "b", "head": "排列顺序", "w": ["意思是希望朋友之间的友好关系", "能够一直继续下去，越久越好", "人们常说“友谊地久天长”"], "a": ["人们常说“友谊地久天长”意思是希望朋友之间的友好关系能够一直继续下去，越久越好"], "key": "CAB"}, {"n": 57, "t": "b", "head": "排列顺序", "w": ["只要找出文中的关键信息", "就可以在短时间内了解文章的大意", "做到快速阅读其实不难，简单来说"], "a": ["做到快速阅读其实不难，简单来说只要找出文中的关键信息就可以在短时间内了解文章的大意"], "key": "CAB"}, {"n": 58, "t": "b", "head": "排列顺序", "w": ["请不要在园区内抽烟，谢谢", "欢迎大家来到国家森林公园", "为了保证您和他人的安全"], "a": ["欢迎大家来到国家森林公园为了保证您和他人的安全请不要在园区内抽烟，谢谢"], "key": "BCA"}, {"n": 59, "t": "b", "head": "排列顺序", "w": ["如果你不能勇敢地走出第一步", "所以，千万不要因为害怕失败而不敢开始", "就永远没有机会获得成功"], "a": ["如果你不能勇敢地走出第一步就永远没有机会获得成功所以，千万不要因为害怕失败而不敢开始"], "key": "ACB"}, {"n": 60, "t": "b", "head": "排列顺序", "w": ["不过这里以前比较安静", "我对这里当然熟悉了，我家原来就住这儿附近", "不像现在这么热闹"], "a": ["我对这里当然熟悉了，我家原来就住这儿附近不过这里以前比较安静不像现在这么热闹"], "key": "BAC"}]}, {"sec": "R", "part": 2, "label": "61-65", "head": "第56-65题：排列顺序。", "ex": "A 可是今天起晚了　B 平时我骑自行车上下班　C 所以就打车来公司 → B A C", "qs": [{"n": 61, "t": "b", "head": "排列顺序", "w": ["就是有时语法上会有点儿小错误", "他的中文说得很流利", "但我们交流起来完全没问题"], "a": ["他的中文说得很流利就是有时语法上会有点儿小错误但我们交流起来完全没问题"], "key": "BAC"}, {"n": 62, "t": "b", "head": "排列顺序", "w": ["这样到时候你才不会手忙脚乱", "无论干什么事情", "最好都能提前做好计划"], "a": ["无论干什么事情最好都能提前做好计划这样到时候你才不会手忙脚乱"], "key": "BCA"}, {"n": 63, "t": "b", "head": "排列顺序", "w": ["意思是希望孩子能健健康康地长大", "“虎头鞋”因其前半部分像老虎头而得名", "有些地方父母会给一岁左右的孩子穿上这种鞋"], "a": ["“虎头鞋”因其前半部分像老虎头而得名有些地方父母会给一岁左右的孩子穿上这种鞋意思是希望孩子能健健康康地长大"], "key": "BCA"}, {"n": 64, "t": "b", "head": "排列顺序", "w": ["4年的留学生活很快就要结束了", "相信这些都会成为我日后的美好回忆", "我在这里经历了很多，也学到了很多"], "a": ["4年的留学生活很快就要结束了我在这里经历了很多，也学到了很多相信这些都会成为我日后的美好回忆"], "key": "ACB"}, {"n": 65, "t": "b", "head": "排列顺序", "w": ["我们还是把它推到里面去吧", "把这个地方空出来", "沙发太大了，放这儿容易堵着门，进出不方便"], "a": ["沙发太大了，放这儿容易堵着门，进出不方便我们还是把它推到里面去吧把这个地方空出来"], "key": "CAB"}]}, {"sec": "R", "part": 3, "label": "66-70", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 66, "t": "c", "p": "各位乘客，大家好，感谢大家乘坐此次航班，我们的飞机将于20分钟后降落在北京首都国际机场。", "s": "★ 飞机：", "o": ["晚点了", "要降落了", "由北京出发", "刚起飞不久"], "a": "B"}, {"n": 67, "t": "c", "p": "上午来应聘的那个小伙子是学电子技术的，成绩很优秀，通过面试时和他的对话，感觉他的性格也不错，我觉得他挺适合这份工作的。", "s": "★ 他觉得那个小伙子怎么样？", "o": ["很帅", "不诚实", "性格好", "能力一般"], "a": "C"}, {"n": 68, "t": "c", "p": "生活中有这样两种人：一种总是看别人怎么生活，另一种喜欢生活给别人看。其实，每个人有每个人的生活，不用羡慕他人，也用不着向别人证明什么，只要用心走好自己的路，幸福就在前方。", "s": "★ 根据这段话，我们应该：", "o": ["学会拒绝", "少发脾气", "保护自己", "过好自己的生活"], "a": "D"}, {"n": 69, "t": "c", "p": "除了正式的名字，中国人一般都有个小名。往往孩子还没出生，父母就已经起好了小名。小名一般都比较好听好记，而且多数是两个相同的字，例如“乐乐”“笑笑”“聪聪”等。", "s": "★ 小名往往：", "o": ["比较好记", "都很浪漫", "不受重视", "是一种玩笑"], "a": "A"}, {"n": 70, "t": "c", "p": "我叫张远，今天上午在图书馆丢了一张饭卡，卡上有我的姓名和学号。如果有同学看见了我的饭卡，请速与我联系，非常感谢。", "s": "★ 他写这段话的目的是：", "o": ["道歉", "找回饭卡", "通知朋友", "申请奖学金"], "a": "B"}]}, {"sec": "R", "part": 3, "label": "71-75", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 71, "t": "c", "p": "时间是无价的，一个人再怎么有钱，也买不到时间。知识忘了可以重新学，钱花光了可以再赚，可是时间过去了就永远回不来了。", "s": "★ 这段话主要想告诉我们：", "o": ["要勇敢", "知识很重要", "要管理好钱", "不要浪费时间"], "a": "D"}, {"n": 72, "t": "c", "p": "很多网站上都说，刷牙时在牙膏上加点儿盐，坚持一段时间，就能使牙变白。我打算试试，看看这个方法究竟有没有效。", "s": "★ “这个方法”指的是：", "o": ["吃7分饱", "自备塑料袋", "皮肤增白法", "牙膏里加盐"], "a": "D"}, {"n": 73, "t": "c", "p": "山东省烟台市是中国著名的“苹果之都”。由于气候等自然条件较好，那儿的苹果个儿大，味道香甜，颜色也漂亮，吸引了很多人前去购买。", "s": "★ 烟台：", "o": ["空气差", "常下雪", "苹果很有名", "到处是葡萄树"], "a": "C"}, {"n": 74, "t": "c", "p": "很多人习惯在早上锻炼身体，但室外锻炼并不是越早越好，尤其是冬天，日出前温度较低，并不适合运动。医生建议：冬季锻炼最好选在日出后，而且运动量不要太大，可以跑跑步、打打羽毛球等。", "s": "★ 冬季锻炼最好：", "o": ["在室内", "穿厚点儿", "日出后进行", "别超过半小时"], "a": "C"}, {"n": 75, "t": "c", "p": "这是本介绍最新科学发现和研究的杂志，它的语言简单易懂，而且十分幽默。像我这种对科学完全不感兴趣的人，读起来竟然也会觉得很有趣。", "s": "★ 那本杂志：", "o": ["页数很多", "很有意思", "很难理解", "是关于艺术的"], "a": "B"}]}, {"sec": "R", "part": 3, "label": "76-79", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 76, "t": "c", "p": "有些人对自己要求非常严格，不允许自己出现任何错误。虽然对自己要求高是好事，但谁都会有缺点，我们应该学会接受自己的缺点，并想办法把它们改掉。", "s": "★ 这段话告诉我们，要：", "o": ["有礼貌", "接受批评", "正确认识缺点", "学会原谅别人"], "a": "C"}, {"n": 77, "t": "c", "p": "今天的晚会太精彩了，特别是那些外国留学生表演的中国功夫，动作既标准又好看，非常棒。以后如果还有这样的晚会，一定要告诉我啊。", "s": "★ 他认为功夫表演：", "o": ["好极了", "让人失望", "不太合格", "让人很放松"], "a": "A"}, {"n": 78, "t": "c", "p": "“责任感”指的是一种对工作负责的态度。一个人即使能力再高，经验再丰富，如果缺少责任感，也很难获得别人的尊重。", "s": "★ 责任感能使人：", "o": ["赢得尊重", "获得支持", "变得自信", "得到鼓励"], "a": "A"}, {"n": 79, "t": "c", "p": "我叔叔以前是记者，因为职业的关系，他几乎走遍了亚洲所有的国家，看到了很多美景，也认识了许多朋友，后来他把自己的经历写成了一本书。", "s": "★ 他叔叔：", "o": ["力气很大", "爱看小说", "体育很好", "去过很多国家"], "a": "D"}]}, {"sec": "R", "part": 3, "label": "80-81", "head": "第66-85题：请选出正确答案。", "passage": ["很晚了，5岁的女儿还在看电视。我对她说：“再看10分钟就去洗脸睡觉。”她不高兴地说：“10分钟太短了。”于是我说：“那就600秒，够长了吧？”女儿听后开心地说：“够了够了，妈妈真好。”"], "qs": [{"n": 80, "t": "c", "s": "★ 她让女儿：", "o": ["洗澡", "快去睡", "早点儿起床", "弹会儿钢琴"], "a": "B"}, {"n": 81, "t": "c", "s": "★ 女儿为什么后来又高兴了？", "o": ["鱼做好了", "收到礼物了", "受到表扬了", "以为时间增加了"], "a": "D"}]}, {"sec": "R", "part": 3, "label": "82-83", "head": "第66-85题：请选出正确答案。", "passage": ["现在全世界大约80多个国家有高速公路。高速公路一般能适应每小时120公里或者更高的速度，其发展情况往往可以看出一个国家的交通及经济发展水平。高速公路既有优点也有缺点，优点是行车速度快，安全方便，可以减少铁路等方面的交通压力；缺点是对环境影响大、收费高。"], "qs": [{"n": 82, "t": "c", "s": "★ 通过高速公路，可以判断该国的：", "o": ["经济水平", "教育情况", "汽车数量", "环境质量"], "a": "A"}, {"n": 83, "t": "c", "s": "★ 高速公路有什么优点？", "o": ["不堵车", "污染小", "行车快且方便", "周围收费站少"], "a": "C"}]}, {"sec": "R", "part": 3, "label": "84-85", "head": "第66-85题：请选出正确答案。", "passage": ["虽然我们常说要按规定做事，但有句话叫“规定是死的，人是活的”。它提醒我们，当“规定”和“经验”不能解决问题时，应该改变自己的态度和想法，试着走走以前从来没走过的路，也许这样就能找到解决问题的方法了。"], "qs": [{"n": 84, "t": "c", "s": "★ “人是活的”这里“活”指的是：", "o": ["富有热情", "懂得改变", "有同情心", "感情丰富"], "a": "B"}, {"n": 85, "t": "c", "s": "★ 根据这段话，规定：", "o": ["可以被打破", "越详细越好", "要符合法律", "不能太复杂"], "a": "A"}]}, {"sec": "W", "part": 1, "label": "86-90", "head": "第86-95题：完成句子。", "ex": "那座桥　800年的　历史　有　了 → 那座桥有800年的历史了。", "qs": [{"n": 86, "t": "b", "w": ["不错", "这台", "质量", "洗衣机的"], "a": ["这台洗衣机的质量不错。"]}, {"n": 87, "t": "b", "w": ["著名的", "是", "她丈夫", "京剧演员"], "a": ["她丈夫是著名的京剧演员。"]}, {"n": 88, "t": "b", "w": ["我", "客厅", "把", "收拾", "好了"], "a": ["我把客厅收拾好了。"]}, {"n": 89, "t": "b", "w": ["两", "公里", "大概有", "加油站离这儿"], "a": ["加油站离这儿大概有两公里。"]}, {"n": 90, "t": "b", "w": ["发生", "在", "这个故事", "上个世纪末"], "a": ["这个故事发生在上个世纪末。"]}]}, {"sec": "W", "part": 1, "label": "91-95", "head": "第86-95题：完成句子。", "ex": "那座桥　800年的　历史　有　了 → 那座桥有800年的历史了。", "qs": [{"n": 91, "t": "b", "w": ["意见和看法", "谈了", "大家", "都", "自己的"], "a": ["大家都谈了自己的意见和看法。"]}, {"n": 92, "t": "b", "w": ["要", "好习惯", "的", "养成", "节约用水"], "a": ["要养成节约用水的好习惯。"]}, {"n": 93, "t": "b", "w": ["普通话", "他的", "说得", "不太标准"], "a": ["他的普通话说得不太标准。"]}, {"n": 94, "t": "b", "w": ["出发还", "吗", "你现在", "来得及"], "a": ["你现在出发还来得及吗？"]}, {"n": 95, "t": "b", "w": ["排好队", "按照", "顺序", "请同学们"], "a": ["请同学们按照顺序排好队。"]}]}, {"sec": "W", "part": 2, "label": "96-100", "head": "第96-100题：看图，用词造句。", "qs": [{"n": 96, "t": "w", "head": "看图，用词造句。", "word": "包子", "img": "/hsk2-exam/assets/h41332_96.jpg", "min": 5, "ref": "这家店的包子非常好吃。"}, {"n": 97, "t": "w", "head": "看图，用词造句。", "word": "到底", "img": "/hsk2-exam/assets/h41332_97.jpg", "min": 5, "ref": "答案到底是什么呢？"}, {"n": 98, "t": "w", "head": "看图，用词造句。", "word": "毕业", "img": "/hsk2-exam/assets/h41332_98.jpg", "min": 5, "ref": "祝贺你顺利毕业！"}, {"n": 99, "t": "w", "head": "看图，用词造句。", "word": "抱", "img": "/hsk2-exam/assets/h41332_99.jpg", "min": 5, "ref": "你怎么抱这么多书？我来帮你吧。"}, {"n": 100, "t": "w", "head": "看图，用词造句。", "word": "长城", "img": "/hsk2-exam/assets/h41332_100.jpg", "min": 5, "ref": "下周末我准备去爬长城。"}]}], "hidden": true}