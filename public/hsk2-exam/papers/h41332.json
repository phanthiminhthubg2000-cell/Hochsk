{"id": "h41332", "level": 4, "name": "HSK四级真题 H41332", "audio": ["/hsk2-exam/audio/H41332.mp3"], "dur": {"R": 2400, "W": 1500}, "units": [{"sec": "L", "part": 1, "label": "1-5", "head": "第1-10题：判断对错。", "qs": [{"n": 1, "t": "c", "s": "★ 李经理不在办公室。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 2, "t": "c", "s": "★ 他让小高写邀请信。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 3, "t": "c", "s": "★ 他俩从小就认识。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 4, "t": "c", "s": "★ 叔叔现在还爱打篮球。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 5, "t": "c", "s": "★ 日记是他生活的一部分。", "o": ["对（√）", "错（×）"], "a": "A"}]}, {"sec": "L", "part": 1, "label": "6-10", "head": "第1-10题：判断对错。", "qs": [{"n": 6, "t": "c", "s": "★ 他正在排队买票。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 7, "t": "c", "s": "★ 他希望大家给他发短信。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 8, "t": "c", "s": "★ 生气时别急着做决定。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 9, "t": "c", "s": "★ 妻子觉得房子很便宜。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 10, "t": "c", "s": "★ 手机上网让生活更方便了。", "o": ["对（√）", "错（×）"], "a": "A"}]}, {"sec": "L", "part": 2, "label": "11-15", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 11, "t": "c", "o": ["饺子", "羊肉", "面包", "饼干"], "a": "C"}, {"n": 12, "t": "c", "o": ["警察", "律师", "司机", "售货员"], "a": "C"}, {"n": 13, "t": "c", "o": ["要准时", "椅子不够", "会议推迟了", "不能换座位"], "a": "D"}, {"n": 14, "t": "c", "o": ["变瘦了", "发工资了", "生意谈成了", "签证办好了"], "a": "C"}, {"n": 15, "t": "c", "o": ["约会", "取钱", "改密码", "买信封"], "a": "B"}]}, {"sec": "L", "part": 2, "label": "16-20", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 16, "t": "c", "o": ["邮局", "教室", "地铁站", "卫生间"], "a": "D"}, {"n": 17, "t": "c", "o": ["家具旧了", "裤子脏了", "眼镜破了", "镜子放低了"], "a": "D"}, {"n": 18, "t": "c", "o": ["洗碗", "扔垃圾", "拿毛巾", "打扫厨房"], "a": "C"}, {"n": 19, "t": "c", "o": ["很愉快", "很难过", "很伤心", "很紧张"], "a": "A"}, {"n": 20, "t": "c", "o": ["王教授", "李校长", "他孙女儿", "一位护士"], "a": "A"}]}, {"sec": "L", "part": 2, "label": "21-25", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 21, "t": "c", "o": ["5毛", "15元", "21元", "35元"], "a": "B"}, {"n": 22, 