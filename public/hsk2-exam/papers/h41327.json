{"id": "h41327", "level": 4, "name": "HSK四级真题 H41327", "audio": ["/hsk2-exam/audio/H41327.mp3"], "dur": {"R": 2400, "W": 1500}, "units": [{"sec": "L", "part": 1, "label": "1-5", "head": "第1-10题：判断对错。", "qs": [{"n": 1, "t": "c", "s": "★ 他暑假想去云南旅游。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 2, "t": "c", "s": "★ 女儿晚上要加班。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 3, "t": "c", "s": "★ 他习惯了这里的生活。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 4, "t": "c", "s": "★ 他们在谈价格。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 5, "t": "c", "s": "★ 中国人喜欢数字“6”。", "o": ["对（√）", "错（×）"], "a": "A"}]}, {"sec": "L", "part": 1, "label": "6-10", "head": "第1-10题：判断对错。", "qs": [{"n": 6, "t": "c", "s": "★ 他几乎每天都去打篮球。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 7, "t": "c", "s": "★ 今天报名还来得及。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 8, "t": "c", "s": "★ 小林是律师。", "o": ["对（√）", "错（×）"], "a": "B"}, {"n": 9, "t": "c", "s": "★ 不要总是羡慕别人。", "o": ["对（√）", "错（×）"], "a": "A"}, {"n": 10, "t": "c", "s": "★ 明天中午有大雪。", "o": ["对（√）", "错（×）"], "a": "B"}]}, {"sec": "L", "part": 2, "label": "11-15", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 11, "t": "c", "o": ["同事", "叔叔", "奶奶", "观众"], "a": "B"}, {"n": 12, "t": "c", "o": ["下雨了", "刚洗完澡", "开空调了", "开着窗户"], "a": "C"}, {"n": 13, "t": "c", "o": ["步行", "骑车", "坐地铁", "坐出租车"], "a": "D"}, {"n": 14, "t": "c", "o": ["打网球", "擦桌子", "洗衣服", "找袜子"], "a": "A"}, {"n": 15, "t": "c", "o": ["太随便", "写得不错", "没原来的好", "与实际不符"], "a": "B"}]}, {"sec": "L", "part": 2, "label": "16-20", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 16, "t": "c", "o": ["暂时别卖", "上网看看", "先借一个用", "找朋友商量"], "a": "B"}, {"n": 17, "t": "c", "o": ["填表", "寄东西", "买铅笔", "打印菜单"], "a": "A"}, {"n": 18, "t": "c", "o": ["想请假", "在办护照", "下周出差", "拿到签证了"], "a": "D"}, {"n": 19, "t": "c", "o": ["是教授", "成绩不好", "在开玩笑", "考上了博士"], "a": "D"}, {"n": 20, "t": "c", "o": ["开会", "买手机", "发传真", "写邀请信"], "a": "A"}]}, {"sec": "L", "part": 2, "label": "21-25", "head": "第11-25题：请选出正确答案。", "qs": [{"n": 21, "t": "c", "o": ["很无聊", "很奇怪", "十分精彩", "让人失望"], "a": "C"}, {"n":