: "第46-50题：选词填空。", "ref": {"kind": "words", "items": [{"k": "A", "hz": "拉"}, {"k": "B", "hz": "圆"}, {"k": "C", "hz": "完全"}, {"k": "D", "hz": "坚持"}, {"k": "E", "hz": "重点"}, {"k": "F", "hz": "饺子"}]}, "unique": true, "qs": [{"n": 46, "t": "m", "a": "B", "pre": "今天晚上的月亮又大又", "post": "，真漂亮，咱们出去走走吧。"}, {"n": 47, "t": "m", "a": "F", "pre": "我最喜欢过年，全家人在一起包", "post": "，热闹极了。"}, {"n": 48, "t": "m", "a": "C", "pre": "他", "post": "有能力做好这件事，但他没有认真去做。"}, {"n": 49, "t": "m", "a": "A", "pre": "那棵树特别粗，要四五个大人手", "post": "手才能抱住。"}, {"n": 50, "t": "m", "a": "E", "pre": "讲话应先讲", "post": "，这样才能使别人更快地了解你想表达的意思。"}], "ex": "她每天都（<b class='exa'>D</b>）走路上下班，所以身体一直很不错。", "exUsed": "D"}, {"sec": "R", "part": 1, "label": "51-55", "head": "第51-55题：选词填空。", "ref": {"kind": "words", "items": [{"k": "A", "hz": "样子"}, {"k": "B", "hz": "超过"}, {"k": "C", "hz": "温度"}, {"k": "D", "hz": "入口"}, {"k": "E", "hz": "严重"}, {"k": "F", "hz": "整理"}]}, "unique": true, "qs": [{"n": 51, "t": "m", "a": "D", "pre": "A：飞机还有40分钟就要起飞了，你怎么还没到？<br>B：路上堵车。我现在在", "post": "处，马上就到。"}, {"n": 52, "t": "m", "a": "F", "pre": "A：能把照片发到我邮箱里吗？<br>B：没问题，把你的邮箱地址告诉我，我", "post": "好了就发给你。"}, {"n": 53, "t": "m", "a": "B", "pre": "A：你好，请问我女儿可以买儿童票吗？<br>B：可以，身高没", "post": "一米二就可以买。"}, {"n": 54, "t": "m", "a": "A", "pre": "A：看", "post": "你对这里很熟悉。<br>B：当然了，我在这儿生活了大约10年，去年才搬走的。"}, {"n": 55, "t": "m", "a": "E", "pre": "A：只是腿擦破了点儿皮，大夫说不", "post": "。<br>B：没事就好，你先躺下休息一会儿吧。"}], "ex": "A：今天真冷啊，好像白天最高（<b class='exa'>C</b>）才2℃。<br>B：刚才电视里说明天更冷。", "exUsed": "C"}, {"sec": "R", "part": 2, "label": "56-60", "head": "第56-65题：排列顺序。", "ex": "A 可是今天起晚了　B 平时我骑自行车上下班　C 所以就打车来公司 → B A C", "qs": [{"n": 56, "t": "b", "head": "排列顺序", "w": ["至少我们努力过", "即使失败了也没关系", "机会来了，就该主动去试一试"], "a": ["机会来了，就该主动去试一试即使失败了也没关系至少我们努力过"], "key": "CBA"}, {"n": 57, "t": "b", "head": "排列顺序", "w": ["但世界上还有很多是钱买不到、也换不来的", "钱虽然能买到很多东西", "例如生命、爱情、友谊和时间"], "a": ["钱虽然能买到很多东西但世界上还有很多是钱买不到、也换不来的例如生命、爱情、友谊和时间"], "key": "BAC"}, {"n": 58, "t": "b", "head": "排列顺序", "w": ["北方秋天很干燥，你刚来", "觉得不适应很正常", "每天多喝水，习惯了就不会那么难受了"], "a": ["北方秋天很干燥，你刚来觉得不适应很正常每天多喝水，习惯了就不会那么难受了"], "key": "ABC"}, {"n": 59, "t": "b", "head": "排列顺序", "w": ["实际上，很多问题的答案都可以从生活中找到", "课本上的知识并不能解决我们遇到的所有问题", "但这需要我们用眼睛去发现，用心去总结"], "a": ["课本上的知识并不能解决我们遇到的所有问题实际上，很多问题的答案都可以从生活中找到但这需要我们用眼睛去发现，用心去总结"], "key": "BAC"}, {"n": 60, "t": "b", "head": "排列顺序", "w": ["还能扩大知识面", "我提高汉语水平的方法就是坚持看中文报纸", "这样不但能学到很多新的词语"], "a": ["我提高汉语水平的方法就是坚持看中文报纸这样不但能学到很多新的词语还能扩大知识面"], "key": "BCA"}]}, {"sec": "R", "part": 2, "label": "61-65", "head": "第56-65题：排列顺序。", "ex": "A 可是今天起晚了　B 平时我骑自行车上下班　C 所以就打车来公司 → B A C", "qs": [{"n": 61, "t": "b", "head": "排列顺序", "w": ["这些家具很多都是他帮忙抬上来的", "力气却大得很", "别看小黄个子不高，人也瘦"], "a": ["别看小黄个子不高，人也瘦力气却大得很这些家具很多都是他帮忙抬上来的"], "key": "CBA"}, {"n": 62, "t": "b", "head": "排列顺序", "w": ["飞往该市的好几趟航班", "昨晚19时南京市突然下起了大雨", "都不得不推迟起飞"], "a": ["昨晚19时南京市突然下起了大雨飞往该市的好几趟航班都不得不推迟起飞"], "key": "BAC"}, {"n": 63, "t": "b", "head": "排列顺序", "w": ["我家离北京很近", "所以周末和节假日我一般都会回家", "只有100多公里，开车的话大约一个小时就到了"], "a": ["我家离北京很近只有100多公里，开车的话大约一个小时就到了所以周末和节假日我一般都会回家"], "key": "ACB"}, {"n": 64, "t": "b", "head": "排列顺序", "w": ["懂得互相信任和尊重才是最重要的", "两个人既然决定共同生活", "那么，只有浪漫和新鲜感是不够的"], "a": ["两个人既然决定共同生活那么，只有浪漫和新鲜感是不够的懂得互相信任和尊重才是最重要的"], "key": "BCA"}, {"n": 65, "t": "b", "head": "排列顺序", "w": ["一看见医生就哭，他怎么都没想到", "我长大后竟然会成为一名护士", "爸爸说我小时候特别害怕打针"], "a": ["爸爸说我小时候特别害怕打针一看见医生就哭，他怎么都没想到我长大后竟然会成为一名护士"], "key": "CAB"}]}, {"sec": "R", "part": 3, "label": "66-70", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 66, "t": "c", "p": "每个人都有缺点，再优秀的人也一样。我们总是很容易看到一个人的缺点，但是别忘了，他身上的优点更值得我们去发现、去学习。", "s": "★ 这段话提醒我们要：", "o": ["有耐心", "接受批评", "学会原谅", "看到别人的优点"], "a": "D"}, {"n": 67, "t": "c", "p": "森林有改变小范围气候的作用。在高温的夏季，森林内的温度会比周围低3到5℃；而在寒冷多风的冬季，森林能起到降低风速、提高气温的作用。", "s": "★ 夏季，森林可以：", "o": ["降低气温", "改变风向", "增加雨量", "使皮肤湿润"], "a": "A"}, {"n": 68, "t": "c", "p": "选择职业时，我们首先应该对自己有清楚的认识，不仅要知道自己想做什么，还要根据自己的性格、爱好去判断什么样的工作适合自己，这样才能找到满意的工作。", "s": "★ 选择职业时，应该：", "o": ["多调查", "打好基础", "及时总结", "先认清自己"], "a": "D"}, {"n": 69, "t": "c", "p": "有些人通过节食的方法来减肥，虽然有效，但是时间长了身体会受不了。真正健康的减肥方法应该是多锻炼，这样做既对身体好，还能让自己看起来更有精神。", "s": "★ 想要健康减肥，应该：", "o": ["多运动", "少吃米饭", "经常站着", "多玩儿电子游戏"], "a": "A"}, {"n": 70, "t": "c", "p": "张先生，这儿离你们公司也就两三站的距离，周围环境不错，对面有超市和银行，房租也不贵，您要不要再考虑一下？", "s": "★ 张先生：", "o": ["被骗了", "住在附近", "在找房子", "在看广告"], "a": "C"}]}, {"sec": "R", "part": 3, "label": "71-75", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 71, "t": "c", "p": "大城市和小城市各有各的好处。大城市的工作机会确实多一些，但竞争的压力大；相反，在小城市生活就会轻松许多。", "s": "★ 他觉得小城市：", "o": ["更安静", "收入高", "招聘会多", "生活压力小"], "a": "D"}, {"n": 72, "t": "c", "p": "如果一个人必须要完成一件自己不喜欢的事情，最好的办法就是早点儿把它做完，这样才能提前结束烦恼。", "s": "★ 对不喜欢却又必须做的事，最好：", "o": ["找人帮忙", "交给别人", "早点儿完成", "留到最后做"], "a": "C"}, {"n": 73, "t": "c", "p": "老教授对新生说：“从今天起，如果你每天用100字把自己的生活写下来，毕业时你将会得到一本10多万字的书，内容就是你4年大学生活的美好回忆。”", "s": "★ 老教授希望学生：", "o": ["诚实", "别太得意", "经常复习", "记下自己的生活"], "a": "D"}, {"n": 74, "t": "c", "p": "语言是人们交流的工具，音乐也是一种语言，人们可以用它来表达自己的感情，而且和其他语言比起来，音乐表达的感情有时更容易让人听懂。", "s": "★ 根据这段话，音乐表达的感情：", "o": ["复杂多变", "让人难过", "更容易理解", "让人印象更深"], "a": "C"}, {"n": 75, "t": "c", "p": "很多时候，人们习惯根据过去的经验做事，但有时候也不能完全相信经验，而应该根据不同的情况选择不同的方法，这样才不容易出错。", "s": "★ 根据这段话，过去的经验：", "o": ["更准确", "值得重视", "无法被证明", "不一定适合现在"], "a": "D"}]}, {"sec": "R", "part": 3, "label": "76-79", "head": "第66-85题：请选出正确答案。", "qs": [{"n": 76, "t": "c", "p": "马校长介绍说，学校举办这次文化节活动，一方面是想让各国学生更好地了解中国，另一方面是想为学生们提供互相交流和学习的机会。", "s": "★ 学校举办这次活动，是想帮助学生们：", "o": ["认识汉字", "熟悉校园", "提高信心", "相互增加了解"], "a": "D"}, {"n": 77, "t": "c", "p": "他平时就对自己要求很严格，尤其是赛前那个星期，他每天都会把全部动作练习好几遍，希望在比赛中做到最好。", "s": "★ 比赛前，他：", "o": ["更努力", "十分兴奋", "非常着急", "停止了练习"], "a": "A"}, {"n": 78, "t": "c", "p": "拒绝握手是不礼貌的，不过当手不干净时，可以先拒绝，然后马上解释原因并对此表示抱歉，否则可能引起误会，让人以为你不友好。", "s": "★ 拒绝握手后为什么要马上道歉？", "o": ["减少误会", "怕人怀疑", "想引人同情", "想获得表扬"], "a": "A"}, {"n": 79, "t": "c", "p": "叶诗文是中国著名的游泳运动员，她6岁时就比同龄人高不少，老师看她手脚也大，身体其他条件也很符合游泳运动员的要求，就鼓励她专门去学游泳。尽管她现在只有16岁，但已经获得了好几个国际大奖。", "s": "★ 老师鼓励叶诗文学游泳，是因为觉得她：", "o": ["聪明", "跑得快", "获过奖", "身体条件好"], "a": "D"}]}, {"sec": "R", "part": 3, "label": "80-81", "head": "第66-85题：请选出正确答案。", "passage": ["目的地也许只有一个，但是通往目的地的道路却有很多条。所以，当一条路走不通时，我们可以换另外一条试试。只要我们不放弃努力，总会找到一条合适的路，通往成功的目的地。"], "qs": [{"n": 80, "t": "c", "s": "★ 当一条路走不通时，我们应该：", "o": ["看地图", "试试别的路", "向当地人问路", "给朋友打电话"], "a": "B"}, {"n": 81, "t": "c", "s": "★ 这段话主要想告诉我们：", "o": ["要有理想", "工作要积极", "成功需要坚持", "做事要有计划"], "a": "C"}]}, {"sec": "R", "part": 3, "label": "82-83", "head": "第66-85题：请选出正确答案。", "passage": ["顾客朋友们，本店现推出“购书送好礼”活动，购书满100元即可获得日记本一个，满200元可获得字典一部。另外，部分图书还有打折活动，其中，小说7.5折，杂志8折，研究生入学考试用书等6折。欢迎选购！祝您购物愉快！"], "qs": [{"n": 82, "t": "c", "s": "★ 购书满100元能获得什么礼物？", "o": ["词典", "日记本", "故事书", "汉语书"], "a": "B"}, {"n": 83, "t": "c", "s": "★ 根据这段话，可以知道：", "o": ["小说半价", "放寒假了", "有些书打折", "书店生意很好"], "a": "C"}]}, {"sec": "R", "part": 3, "label": "84-85", "head": "第66-85题：请选出正确答案。", "passage": ["保护地球环境，并不是离我们很远、很难做到的事情。实际上，我们只需注意一下身边的小事就可以。出门时记得关空调和电脑，节约用电；少开车，多骑车或者坐公共汽车，降低空气污染；买菜时自备购物袋，少用塑料袋，减少白色污染……这些虽然都是小事，却有实实在在的效果。"], "qs": [{"n": 84, "t": "c", "s": "★ 为了减少白色污染，我们应该：", "o": ["少说多做", "节约用水", "少用塑料袋", "少用一次性筷子"], "a": "C"}, {"n": 85, "t": "c", "s": "★ 这段话主要谈什么？", "o": ["社会责任", "环境保护", "节约与浪费", "经济的发展"], "a": "B"}]}, {"sec": "W", "part": 1, "label": "86-90", "head": "第86-95题：完成句子。", "ex": "那座桥　800年的　历史　有　了 → 那座桥有800年的历史了。", "qs": [{"n": 86, "t": "b", "w": ["你最好", "一个密码", "重新", "换"], "a": ["你最好重新换一个密码。"]}, {"n": 87, "t": "b", "w": ["不允许", "医院", "抽烟", "里"], "a": ["医院里不允许抽烟。"]}, {"n": 88, "t": "b", "w": ["看法", "我", "跟你的", "差不多"], "a": ["我跟你的看法差不多。"]}, {"n": 89, "t": "b", "w": ["发生了", "这儿究竟", "什么", "事情"], "a": ["这儿究竟发生了什么事情？"]}, {"n": 90, "t": "b", "w": ["他", "一个", "美丽的", "小城市", "出生在"], "a": ["他出生在一个美丽的小城市。"]}]}, {"sec": "W", "part": 1, "label": "91-95", "head": "第86-95题：完成句子。", "ex": "那座桥　800年的　历史　有　了 → 那座桥有800年的历史了。", "qs": [{"n": 91, "t": "b", "w": ["房间", "把", "收拾得", "姐姐", "很整齐"], "a": ["姐姐把房间收拾得很整齐。"]}, {"n": 92, "t": "b", "w": ["是", "负责的", "由李经理", "这次调查"], "a": ["这次调查是由李经理负责的。"]}, {"n": 93, "t": "b", "w": ["反对这样做", "大概", "三分之二的人", "有"], "a": ["大概有三分之二的人反对这样做。"]}, {"n": 94, "t": "b", "w": ["学校", "去参观", "长城", "将", "组织大家"], "a": ["学校将组织大家去参观长城